{
  "name": "privacyflow-agent-zero-channel",
  "version": "0.1.0",
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.0.0",
    "express": "npm:express@^4.19.0",
    "zod": "npm:zod@^3.23.0"
  },
  "tasks": {
    "start": "deno run --allow-all --env-file=.env src/main.ts",
    "dev": "deno run --allow-all --env-file=.env --watch src/main.ts",
    "test": "deno test --allow-all --env-file=.env",
    "check": "deno check src/",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
